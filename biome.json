{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "files": {
    "includes": [
      "**/*.ts",
      "!**/dist/**",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!.atl/**",
      "!.codegraph/**",
      "!openapi/**"
    ]
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": { "enabled": true, "rules": { "recommended": true } }
}
