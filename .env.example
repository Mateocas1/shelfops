# Database connection shared by the API process and the one-off migration task.
# Replace every placeholder before use and never commit real credentials.
DATABASE_URL=postgres://shelfops:replace-with-database-password@localhost:5432/shelfops

# disable | require | verify-full
# verify-full verifies the server certificate against the CA at DATABASE_SSL_CA_PATH.
DATABASE_SSL_MODE=disable
# Optional. Defaults to certs/global-bundle.pem (the bundled Amazon RDS trust store).
DATABASE_SSL_CA_PATH=replace-with-absolute-ca-bundle-path

# Pool bounds for the API process; each value is a positive integer.
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_TIMEOUT_MS=10000

# Entrypoint hardening.
# TRUST_PROXY: false or trusted proxy hop count; defaults to 1 when NODE_ENV=production, false otherwise.
TRUST_PROXY=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Comma-separated exact scheme://host origins; empty denies cross-origin requests.
CORS_ALLOWED_ORIGINS=
